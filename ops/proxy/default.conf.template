log_format kiska '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';
server {
    access_log /var/log/nginx/access.log kiska;
    listen 8080;
    server_name _;
    server_tokens off;
    client_max_body_size 5m;
    set_real_ip_from ${HTTPS_PROXY_IP};
    real_ip_header X-Forwarded-For;
    resolver 127.0.0.11 ipv6=off valid=10s;

    # Preserve the exact Host and URI used to sign GET. Only application-generated
    # object paths are exposed. Bucket listing and all write methods stay private.
    location ~ "^/${S3_BUCKET}/[0-9a-f-]{36}/[0-9a-f-]{36}/[0-9a-f-]{36}\.webp$" {
        limit_except GET { deny all; }
        set $s3_origin storage-edge:8333;
        proxy_pass http://$s3_origin$request_uri;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_hide_header Cache-Control;
        add_header Cache-Control "private, no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }
    location /${S3_BUCKET}/ { return 404; }
    location / {
        set $app_origin app-edge:8080;
        proxy_pass http://$app_origin$request_uri;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
